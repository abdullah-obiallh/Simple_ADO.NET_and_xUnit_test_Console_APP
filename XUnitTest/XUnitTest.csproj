<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Need C# version 10+ for nullable reference types and implicit usings -->
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContactsBusinessLayer\ContactsBusinessLayer.csproj" />
    <ProjectReference Include="..\ContactsConsoleApp\ContactsConsoleApp-PresentationLayer.csproj" />
    <ProjectReference Include="..\ContactsDataAccessLayer\ContactsDataAccessLayer.csproj" />
  </ItemGroup>

</Project>
